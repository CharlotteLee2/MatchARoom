generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Site {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  baseUrl   String
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id          Int        @id @default(autoincrement())
  title       String
  address     String?
  price       Int?
  link        String     @unique
  imageUrl    String?
  dateScraped DateTime   @default(now())
  siteId      Int
  favorites   Favorite[]
  site        Site       @relation(fields: [siteId], references: [id])
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  password  String
  favorites Favorite[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  listingId Int
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
}
